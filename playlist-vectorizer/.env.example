# Copy to .env and fill in. Never commit the real .env.

# Register an app at https://developer.spotify.com/dashboard
# Redirect URI must match exactly what you register there.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# https://www.last.fm/api/account/create (free, non-commercial use)
LASTFM_API_KEY=
LASTFM_API_SECRET=

# https://www.discogs.com/settings/developers (optional, genre/style enrichment)
DISCOGS_TOKEN=

# Required by MusicBrainz's API etiquette: "AppName/Version (contact-url-or-email)"
MUSICBRAINZ_USER_AGENT=playlist-vectorizer/0.1 (you@example.com)

# Directory holding extracted AcousticBrainz dump JSON (see README "Step 2" for layout).
# Leave unset to skip the offline AcousticBrainz lookup entirely.
ACOUSTICBRAINZ_DUMP_DIR=

# Directory holding downloaded Essentia .pb model files (discogs-effnet
# embedding model + classifier heads), from https://essentia.upf.edu/models.html
# Leave unset to run MusicExtractor's built-in descriptors only (no CC BY-NC-SA
# model files needed). See README licensing note before setting this.
ESSENTIA_MODELS_DIR=

# Root directory for cache, audio, and parquet checkpoints. Defaults to ./data.
PV_DATA_DIR=./data
